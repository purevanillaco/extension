{
	"short_name": "PureVanilla",
	"author": "PureVanilla",
	"background": {
		"service_worker": "background.js"
	},
	"description": "Automatically vote for the server using this extension",
	"manifest_version": 3,
	"name": "PureVanilla",
	"icons": {
		"16": "images/icon16.png",
		"32": "images/icon32.png",
		"48": "images/icon48.png"
	},
	"permissions": [
		"background",
		"webNavigation",
		"webRequest",
		"unlimitedStorage",
		"scripting",
		"tabGroups"
	],
	"optional_permissions": [
		"cookies"
	],
	"host_permissions": [
		"<all_urls>"
	],
	"content_scripts": [
		{
			"matches": [
				"https://purevanilla.co/*"
			],
			"js": [
				"content.js"
			]
		}
	],
	"update_url": "https://clients2.google.com/service/update2/crx",
	"version": "1.0.3",
	"minimum_chrome_version": "105.0"
}